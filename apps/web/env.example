# Copy to apps/web/.env.local. Server-only values never carry the NEXT_PUBLIC_ prefix.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Disabled unless an existing approved legacy client is explicitly enabled.
FITBIT_LEGACY_ENABLED=false
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=

# Phase 8 (the screens). Leave the two Supabase values empty to run on this device only:
# progress is then saved in the browser and no account is needed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Live wearable buttons stay off until the Phase 2 routes are merged and configured.
NEXT_PUBLIC_PROVIDERS_ENABLED=false
# Marks fact-check rows as "being checked" (OPEN_QUESTIONS: fact-checking sign-off).
NEXT_PUBLIC_SHOW_UNVERIFIED=false
# Billing is not built. No price, trial or guarantee copy appears while this is false.
PRICING_ENABLED=false
