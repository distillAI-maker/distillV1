# Copy to apps/web/.env.local. Server-only; never prefix these with NEXT_PUBLIC_.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Disabled unless an existing approved legacy client is explicitly enabled.
FITBIT_LEGACY_ENABLED=false
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
