{
  "name": "distill",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "catalog:build": "tsx packages/catalog/src/build.ts",
    "catalog:check": "tsx packages/catalog/src/build.ts --check",
    "lint": "eslint packages apps/web scripts/*.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "dev": "pnpm --filter @distill/web dev",
    "build:web": "pnpm --filter @distill/web build",
    "providers:worker": "tsx scripts/provider-worker.ts",
    "routing:golden": "tsx scripts/routing-golden.ts",
    "sim:power": "tsx scripts/sim-power.ts",
    "sim:plot": "python scripts/plot-power.py",
    "sim:labels": "tsx scripts/power-labels.ts",
    "sim:check": "tsx scripts/sim-power.ts --check && tsx scripts/power-labels.ts --check",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "test": "vitest run",
    "tone-lint": "tsx scripts/tone-lint.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm catalog:check && pnpm tone-lint"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@distill/sim": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
